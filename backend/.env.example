# Server Configuration
PORT=5001
NODE_ENV=production

# Database Credentials (Local / PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=gms

# Database Connection URL (For Production Deployment e.g. Supabase / Neon)
DATABASE_URL=postgres://postgres:your_password@db_host:5432/postgres?sslmode=require

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Cloudinary CDN Configuration (Image & Logo Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta WhatsApp Cloud API (Central System Settings)
META_SYSTEM_TOKEN=your_meta_system_token
META_WABA_ID=your_meta_waba_id
